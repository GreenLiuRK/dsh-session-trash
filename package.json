{
  "name": "dsh-session-trash",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Session trash for DeepSeek Harness: delete a conversation into a recoverable trash, restore it, or shred it without leaving logs. | DSH 会话回收站：把对话删进可恢复的回收站，随时还原，或彻底粉碎不留痕迹。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "trash",
    "recycle-bin",
    "delete"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "使用教程.md",
    "scripts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "publish:github": "node scripts/publish.mjs"
  }
}
